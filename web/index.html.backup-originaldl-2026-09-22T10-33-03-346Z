<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AutoSocial Studio</title>
  <link rel="stylesheet" href="style.css" />
  <link rel="stylesheet" href="vendor/phosphor/style.css" />
  <link rel="stylesheet" href="studio-assets/studio.css" />
</head>

<body>
  <div class="app-container">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon">A</div>
        <div class="brand-meta">
          <h1>AutoSocial</h1>
          <div class="brand-account-switcher">
            <select id="brandSelect" class="control-input brand-select"></select>
            <button id="addBrandBtn" type="button" class="control-btn-small brand-add-btn" title="Add brand">
              <i class="ph ph-plus"></i>
            </button>
          </div>
          <div id="brandCreateRow" class="brand-create-row hidden">
            <input id="brandNameInput" type="text" class="control-input brand-name-input"
              placeholder="New brand name" />
            <button id="saveBrandBtn" type="button" class="control-btn-small primary brand-create-btn">
              Add
            </button>
            <button id="cancelBrandBtn" type="button" class="control-btn-small brand-create-btn">
              Cancel
            </button>
          </div>
        </div>
      </div>

      <nav class="nav-menu">
        <button class="nav-item active" data-view="overview">
          <i class="ph ph-squares-four"></i>
          <span>Overview</span>
        </button>

        <div class="nav-label">Create</div>
        <button class="nav-item" data-view="long-video">
          <i class="ph ph-film-strip"></i>
          <span>AI Long Video</span>
        </button>
        <button class="nav-item" data-view="helios">
          <i class="ph ph-images"></i>
          <span>HeliosGen</span>
        </button>

        <div class="nav-label">Auto Post</div>
        <button class="nav-item" data-view="tiktok">
          <i class="ph ph-tiktok-logo"></i>
          <span>TikTok</span>
        </button>
        <button class="nav-item" data-view="instagram">
          <i class="ph ph-instagram-logo"></i>
          <span>Instagram</span>
        </button>
        <button class="nav-item" data-view="youtube">
          <i class="ph ph-youtube-logo"></i>
          <span>YouTube</span>
        </button>
        <button class="nav-item" data-view="google-flow">
          <i class="ph ph-sparkle"></i>
          <span>Google Flow</span>
        </button>
                <!-- MARKER: ACCTAN-NAV-v1 -->
        <button class="nav-item" data-view="account-analysis">
          <i class="ph ph-magnifying-glass-chart"></i>
          <span>Analisis de cuenta</span>
        </button>
<button class="nav-item" data-view="x-autopilot">
          <i class="ph ph-x-logo"></i>
          <span>X Autopilot</span>
        </button>

        <div class="nav-label">Growth</div>
        <button class="nav-item" data-view="competitor">
          <i class="ph ph-binoculars"></i>
          <span>Competencia</span>
        </button>
        <button class="nav-item" data-view="autoclone">
          <i class="ph ph-magic-wand"></i>
          <span>Auto Clone</span>
        </button>

        <div class="nav-label">Tools</div>
        <button class="nav-item" data-view="uniquifier">
          <i class="ph ph-fingerprint"></i>
          <span>Video Uniquifier</span>
        </button>
        <button class="nav-item" data-view="autodownload">
          <i class="ph ph-download-simple"></i>
          <span>Auto Download</span>
        </button>
        <button class="nav-item" data-view="profile-download">
          <i class="ph ph-download"></i>
          <span>Profile Downloader</span>
        </button>

        <div class="nav-label">Management</div>
        <button class="nav-item" data-view="setup">
          <i class="ph ph-list-checks"></i>
          <span>Setup</span>
        </button>
        <button class="nav-item" data-view="accounts">
          <i class="ph ph-users"></i>
          <span>Accounts</span>
        </button>
                <!-- MARKER: AICFG-NAV-v1 -->
        <button class="nav-item" data-view="ai-config">
          <i class="ph ph-brain"></i>
          <span>Configuracion IA</span>
        </button>
<button class="nav-item" data-view="settings">
          <i class="ph ph-gear"></i>
          <span>Settings</span>
        </button>
      </nav>

      <div class="sidebar-footer">
        <div class="connection-status" id="statusBadge">
          <div class="connection-dot"></div>
          <span>System Ready</span>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

      <!-- View: Overview -->
      <section id="view-overview" class="view-section active">
        <header class="view-header">
          <h2>Dashboard Overview</h2>
        </header>

        <!-- Totals Row -->
        <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:12px; margin-bottom:20px;">
          <div class="stat-card">
            <div class="stat-icon"><i class="ph ph-film-strip"></i></div>
            <div class="stat-value" id="pendingCount">0</div>
            <div class="stat-label">Total Pending</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon success"><i class="ph ph-check-circle"></i></div>
            <div class="stat-value success" id="successCount">0</div>
            <div class="stat-label">Total Posted</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon error"><i class="ph ph-warning-circle"></i></div>
            <div class="stat-value error" id="failedCount">0</div>
            <div class="stat-label">Total Failed</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><i class="ph ph-users-three"></i></div>
            <div class="stat-value" id="activeAccountsCount">0</div>
            <div class="stat-label">Active Schedulers</div>
          </div>
        </div>

        <!-- Profiles container (JS populates per-profile sections) -->
        <div id="overviewProfilesContainer"></div>

        <!-- Recent Logs -->
        <div class="card full-width" style="margin-top:20px;">
          <div class="card-title">Live System Logs</div>
          <div class="logs-container" id="logsContainer">
            <!-- JS Populates this -->
          </div>
        </div>
      </section>

      <section id="view-long-video" class="view-section studio-host">
        <div id="longFormStudioRoot"></div>
      </section>

      <!-- View: HeliosGen -->
      <section id="view-helios" class="view-section studio-host">
        <div id="heliosStudioRoot"></div>
      </section>

      <!-- View: Competencia / Modelado -->
      <section id="view-competitor" class="view-section">
        <header class="view-header">
          <div>
            <h2>Competencia / Modelado</h2>
            <span class="view-subtitle">Analiza un perfil de TikTok con IA y genera tu Prompt Maestro de contenido.</span>
          </div>
          <span id="competitorKeyBadge" class="status-badge">Sin API de Gemini</span>
        </header>

        <div class="competitor-search card">
          <div class="competitor-input-row">
            <input id="competitorTarget" class="control-input" type="text"
              placeholder="@usuario o https://www.tiktok.com/@usuario" />
            <select id="competitorDepth" class="control-input competitor-depth">
              <option value="12">12 vídeos</option>
              <option value="24" selected>24 vídeos</option>
              <option value="40">40 vídeos</option>
              <option value="60">60 vídeos</option>
            </select>
            <button id="competitorAnalyzeBtn" class="control-btn primary" type="button">
              <i class="ph ph-magnifying-glass"></i> Analizar
            </button>
          </div>
          <div class="competitor-options">
            <label>Marca: <input id="competitorBrand" class="control-input" type="text" placeholder="Tu marca (opcional)" /></label>
            <label>Idioma: <input id="competitorLanguage" class="control-input competitor-lang" type="text" value="es" /></label>
            <button id="competitorKeyBtn" class="control-btn-small" type="button">Configurar API Gemini</button>
            <button id="competitorHistoryBtn" class="control-btn-small" type="button">Informes guardados</button>
          </div>
          <div id="competitorProgress" class="competitor-progress" hidden></div>
        </div>

        <div id="competitorKeyPanel" class="competitor-key-panel card" hidden>
          <div class="card-title">API key de Gemini (Google AI Studio)</div>
          <p class="form-hint">Se usa para el análisis de texto y visión. Se guarda localmente y nunca sale de tu equipo salvo hacia Google.</p>
          <div class="helios-key-row">
            <input id="competitorApiKey" class="control-input" type="password" placeholder="AIza..." />
            <button id="competitorSaveKeyBtn" class="control-btn-small primary" type="button">Guardar</button>
            <button id="competitorRemoveKeyBtn" class="control-btn-small danger" type="button">Quitar</button>
          </div>
          <div class="helios-key-row">
            <input id="competitorModel" class="control-input" type="text" placeholder="Modelo (ej. gemini-3.6-flash)" />
            <button id="competitorModelsBtn" class="control-btn-small" type="button">Ver modelos disponibles</button>
            <button id="competitorSaveModelBtn" class="control-btn-small primary" type="button">Guardar modelo</button>
          </div>
          <p class="helios-hint" id="competitorKeyStatus"></p>
          <p class="helios-hint" id="competitorModelStatus"></p>
        </div>

        <div id="competitorReportsList" class="competitor-reports card" hidden></div>

        <div id="competitorResult" class="competitor-result" hidden></div>
      </section>

      <!-- View: Auto Clone -->
      <section id="view-autoclone" class="view-section">
        <header class="view-header">
          <div>
            <h2>Auto Clone</h2>
            <span class="view-subtitle">Un solo clic: analiza el perfil, descarga todos sus vídeos, traduce el texto en pantalla al español y uniquifica cada vídeo.</span>
          </div>
          <span id="autocloneKeyBadge" class="status-badge">Sin API de IA</span>
        </header>

        <div class="autoclone-hero card">
          <div class="autoclone-video-row">
            <input id="autocloneVideoUrl" class="control-input autoclone-video-url" type="text"
              placeholder="Pega la URL de un vídeo concreto (ej. https://www.tiktok.com/@usuario/video/123...) — opcional" />
            <button id="autocloneVideoBtn" class="control-btn primary autoclone-video-go" type="button">
              <i class="ph ph-film-slate"></i> Clonar este vídeo
            </button>
          </div>
          <p id="autocloneVideoHint" class="autoclone-video-hint">Si pegas una URL de vídeo aquí, se clona <b>solo ese vídeo</b> y se ignora el usuario de abajo.</p>
          <div class="autoclone-input-row">
            <input id="autocloneUsername" class="control-input autoclone-username" type="text"
              placeholder="@usuario de TikTok  (ej. @usuario o https://www.tiktok.com/@usuario)" />
            <button id="autocloneStartBtn" class="control-btn primary autoclone-go" type="button">
              <i class="ph ph-lightning"></i> Clonar ahora
            </button>
          </div>
          <div class="autoclone-destination">
            <label for="autocloneDestination">Carpeta de destino</label>
            <div class="autoclone-destination-row">
              <input id="autocloneDestination" class="control-input autoclone-dest-input" type="text"
                placeholder="Ej. C:\Videos\TikTok  o  /home/usuario/Videos  (vacío = carpeta interna)" />
              <button id="autocloneOpenFolderBtn" class="control-btn-small" type="button" title="Abrir la carpeta de destino">
                <i class="ph ph-folder-open"></i> Abrir
              </button>
            </div>
            <p id="autocloneDestHint" class="autoclone-dest-hint">Cada usuario tendrá su propia subcarpeta (p. ej. <b>jayandrews69</b>) con todos sus vídeos.</p>
          </div>
          <div class="autoclone-options">
            <label>Máx. vídeos: <input id="autocloneMaxVideos" class="control-input autoclone-num" type="number" min="0" value="0" placeholder="0 = todos" /></label>
            <label>Orden de descarga:
              <select id="autocloneDownloadOrder" class="control-input">
                <option value="oldest" selected>Más antiguos primero</option>
                <option value="recent">Más recientes primero</option>
              </select>
            </label>
            <label>Empezar desde:
              <select id="autocloneStartMode" class="control-input">
                <option value="continue" selected>Donde lo dejé (siguientes)</option>
                <option value="restart">Empezar de nuevo (desde el primero)</option>
              </select>
            </label>
            <button id="autocloneResetHistoryBtn" class="control-btn-small" type="button" title="Olvidar los vídeos ya descargados de este perfil">
              <i class="ph ph-arrow-counter-clockwise"></i> Reiniciar contador
            </button>
            <label>Intensidad uniquifier:
              <select id="autocloneIntensity" class="control-input">
                <option value="suave">Suave - recorte 2%</option>
                <option value="media" selected>Media - recorte 4% + espejo</option>
                <option value="fuerte">Fuerte - recorte 6% + espejo</option>
              </select>
            </label>
            <label>Idioma del título y descripción:
              <select id="autocloneMetadataLanguage" class="control-input">
                <option value="es" selected>Español</option>
                <option value="original">Original</option>
              </select>
            </label>
            <label class="autoclone-check"><input id="autocloneUniquify" type="checkbox" checked /> Uniquificar</label>
            <label class="autoclone-check"><input id="autocloneTranslate" type="checkbox" checked /> Traducir texto en pantalla</label>
            <label class="autoclone-check" title="El texto traducido aparece en el mismo sitio que el original, con la palabra activa resaltada en amarillo sobre fondo negro">
              <input id="autocloneKaraoke" type="checkbox" /> Subtítulos karaoke (amarillo sobre negro)
            </label>
            <label class="autoclone-check"><input id="autocloneDownloadThumbnail" type="checkbox" /> Descargar y usar la portada original del vídeo</label>
            <button id="autocloneKeyBtn" class="control-btn-small" type="button">Configurar API key</button>
            <button id="autocloneCancelBtn" class="control-btn-small danger" type="button" hidden>Cancelar</button>
          </div>
        </div>

        <div id="autocloneKeyPanel" class="competitor-key-panel card" hidden>
          <div class="card-title">API key de Gemini (Google AI Studio)</div>
          <p class="form-hint">Se comparte con la sección Competencia. Se usa para traducir el texto en pantalla. Se guarda localmente.</p>
          <div class="helios-key-row">
            <input id="autocloneApiKey" class="control-input" type="password" placeholder="AIza..." />
            <button id="autocloneSaveKeyBtn" class="control-btn-small primary" type="button">Guardar</button>
          </div>
          <p class="helios-hint" id="autocloneKeyStatus"></p>

          <div class="card-title" style="margin-top:18px;">API key de DeepSeek (4.1 Flash)</div>
          <p class="form-hint">Se usa cuando se agota la cuota gratis de Gemini. En vision sale ~6.7x mas barato que Gemini de pago. Se guarda localmente.</p>
          <div class="helios-key-row">
            <input id="autocloneDeepSeekKey" class="control-input" type="password" placeholder="sk-..." />
            <button id="autocloneSaveDeepSeekKeyBtn" class="control-btn-small primary" type="button">Guardar</button>
          </div>
          <p class="helios-hint" id="autocloneDeepSeekStatus"></p>

          <div class="card-title" style="margin-top:18px;">API key de xKiro (rotacion gratuita)</div>
          <p class="form-hint">Rota entre 4 modelos gratis de xKiro antes de gastar cuota de Gemini. Pega la clave de https://api.xkiro.com. Se guarda localmente.</p>
          <div class="helios-key-row">
            <input id="autocloneXKiroKey" class="control-input" type="password" placeholder="sk-..." />
            <button id="autocloneSaveXKiroKeyBtn" class="control-btn-small primary" type="button">Guardar</button>
          </div>
          <p class="helios-hint" id="autocloneXKiroStatus"></p> <!-- XKC[html] -->
        </div> // DS[ui-panel]

        <div class="autoclone-main">
          <div class="card autoclone-progress-card">
            <div class="card-title">Progreso</div>
            <div class="autoclone-bar"><div id="autocloneBarFill" class="autoclone-bar-fill"></div></div>
            <p id="autocloneStage" class="autoclone-stage">Listo. Escribe un usuario y pulsa «Clonar ahora».</p>
          </div>
          <div class="card autoclone-model-card">
            <div class="card-title">Modelo en uso ahora</div>
            <div id="autocloneModeloActivo" class="autoclone-modelo">
              <span class="autoclone-modelo-prov">—</span>
              <span class="autoclone-modelo-id">Sin actividad</span>
            </div>
            <p id="autocloneModeloDetalle" class="helios-hint">Cuando empiece el trabajo, aqui vera que modelo esta leyendo los fotogramas en ese instante.</p>
            <div id="autocloneModeloHistorial" class="autoclone-modelo-hist"></div>
          </div> <!-- XKI[indicador][html] -->
          <div class="card autoclone-videos-card">
            <div class="card-title">Vídeos procesados</div>
            <div id="autocloneVideos" class="autoclone-videos">
              <p class="autoclone-empty">Aún no hay vídeos en este lote.</p>
            </div>
          </div>
        </div>

        <div id="autocloneAnalysis" class="competitor-result" hidden></div>
      </section>

      <!-- View: Accounts -->
      <section id="view-setup" class="view-section">
        <header class="view-header">
          <div>
            <h2>First-Run Setup</h2>
            <span class="view-subtitle">Check your local machine, login sessions, and queue folders.</span>
          </div>
          <button id="setupRefreshBtn" class="control-btn-small">
            <i class="ph ph-arrows-clockwise"></i> Refresh
          </button>
        </header>

        <div class="setup-layout">
          <div class="setup-summary-card">
            <div class="setup-summary-icon" id="setupSummaryIcon">
              <i class="ph ph-circle-notch"></i>
            </div>
            <div>
              <div class="setup-summary-label">Setup status</div>
              <div class="setup-summary-title" id="setupSummaryTitle">Checking local setup</div>
              <div class="setup-summary-meta" id="setupSummaryMeta">This runs local checks only.</div>
            </div>
          </div>

          <div class="setup-metrics" id="setupMetrics">
            <div class="setup-metric">
              <span class="setup-metric-value">-</span>
              <span class="setup-metric-label">Ready</span>
            </div>
            <div class="setup-metric">
              <span class="setup-metric-value">-</span>
              <span class="setup-metric-label">Warnings</span>
            </div>
            <div class="setup-metric">
              <span class="setup-metric-value">-</span>
              <span class="setup-metric-label">Blocking</span>
            </div>
          </div>
        </div>

        <div class="setup-grid">
          <div class="card setup-card">
            <div class="card-title">Local Health</div>
            <div id="setupChecksList" class="setup-check-list">
              <div class="setup-empty">Loading setup checks...</div>
            </div>
          </div>

          <div class="card setup-card">
            <div class="card-title">Login Sessions</div>
            <div id="setupSessionsList" class="setup-check-list">
              <div class="setup-empty">Loading sessions...</div>
            </div>
          </div>

          <div class="card setup-card full-width">
            <div class="card-title">Where to Put Videos</div>
            <div id="setupFoldersList" class="setup-folder-list">
              <div class="setup-empty">Loading folders...</div>
            </div>
          </div>

          <div class="card setup-card full-width">
            <div class="card-title">Suggested First Run</div>
            <div id="setupNextSteps" class="setup-steps">
              <div class="setup-empty">Loading next steps...</div>
            </div>
          </div>
        </div>
      </section>

      <section id="view-accounts" class="view-section">
        <header class="view-header">
          <div>
            <h2>TikTok Account Manager</h2>
            <span class="view-subtitle">Registro asistido y un perfil persistente de Chromium por cuenta.</span>
          </div>
          <button id="createTikTokAccountBtn" class="control-btn-small primary account-create-button">
            <i class="ph ph-plus-circle"></i> Crear cuenta TikTok
          </button>
        </header>

        <div class="card account-vault-summary">
          <div>
            <div class="card-title">Sesiones locales protegidas</div>
            <p id="accountVaultMessage" class="form-hint">Cada cuenta usa un perfil persistente separado. Completa el registro manualmente con tus datos reales.</p>
          </div>
          <span class="status-badge active">Registro manual</span>
        </div>

        <div id="accountOnboardingPanel" class="card account-onboarding-panel hidden">
          <div class="card-header">
            <div class="card-title">Crear cuenta TikTok de forma asistida</div>
            <span id="accountOnboardingBadge" class="status-badge">Idle</span>
          </div>
          <label class="form-hint" for="newTikTokAccountName">Nombre interno de la cuenta</label>
          <input id="newTikTokAccountName" class="control-input" type="text" maxlength="60" placeholder="Ej. TikTok marca principal" />
          <p id="accountOnboardingMessage" class="form-hint"></p>
          <div class="account-action-row">
            <button id="accountConfirmSetupBtn" class="control-btn-small"><i class="ph ph-check-circle"></i> Comprobar cuenta terminada</button>
            <button id="accountCloseBrowserBtn" class="control-btn-small danger"><i class="ph ph-x-circle"></i> Close Chromium</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title">All TikTok accounts</div>
          <div class="account-table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Local account</th>
                  <th>Browser profile</th>
                  <th>Session</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="managedAccountsTableBody">
                <tr><td colspan="5">Loading accounts...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card" style="margin-top:20px;">
          <div class="card-title">Current account platform sessions <span id="activeBrandLabel" style="color:var(--text-muted); font-size:14px;"></span></div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Platform</th>
                <th>Session</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="accountsTableBody">
              <!-- JS Populates this -->
            </tbody>
          </table>
        </div>
      </section>

      <!-- View: TikTok -->
      <section id="view-tiktok" class="view-section">
        <header class="view-header">
          <div style="display:flex; align-items:center; gap:12px;">
            <div class="brand-icon"
              style="background:linear-gradient(135deg, #00f2ea, #ff0050); width:40px; height:40px; font-size:24px;"><i
                class="ph ph-tiktok-logo"></i></div>
            <div>
              <h2 style="margin:0;">TikTok Auto Post</h2>
              <span style="color:var(--text-muted); font-size:13px;">Manage your TikTok schedule and queue</span>
            </div>
          </div>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button id="ttLoginBtn" class="control-btn-small primary"><i class="ph ph-browser"></i> Iniciar sesión en TikTok</button>
            <button id="ttRunBtn" class="control-btn-small primary"><i class="ph ph-play"></i> Run Once</button>
            <button id="ttStartBtn" class="control-btn-small success"><i class="ph ph-play-circle"></i> Start</button>
            <button id="ttStopBtn" class="control-btn-small danger"><i class="ph ph-stop-circle"></i> Stop</button>
          </div>
        </header>

        <div id="ttLoginBanner" class="tt-login-banner card" hidden>
          <div class="tt-login-row">
            <span class="tt-login-icon"><i class="ph ph-browser"></i></span>
            <div class="tt-login-text">
              <strong id="ttLoginTitle">Sesión de TikTok</strong>
