            <div class="form-group">
              <label>Min Views Filter</label>
              <input type="number" id="pdMinViews" class="control-input" min="0" placeholder="0 = No filter"
                value="0">
            </div>
          </div>
          <div style="margin-top:20px; display:flex; gap:12px;">
            <button id="pdStartBtn" class="control-btn primary">
              <i class="ph ph-play"></i> Start Scraping
            </button>
            <button id="pdScanBtn" class="control-btn neutral" style="border: 1px solid var(--border-color);">
              <i class="ph ph-magnifying-glass"></i> Check Videos
            </button>
            <button id="pdOpenFolderBtn" class="control-btn neutral">
              <i class="ph ph-folder-open"></i> Open Downloads
            </button>
          </div>
        </div>

        <div class="two-col-layout">
          <!-- Live Logs -->
          <div class="card" style="grid-column: 1 / -1;">
            <div class="card-header">
              <h2 class="card-title">Live Logs</h2>
              <span id="pdStatusBadge" class="status-badge">Idle</span>
            </div>
            <div class="logs-container" id="pdLogsContainer">
            </div>
          </div>
        </div>
      </section>

      <section id="view-google-flow" class="view-section">
        <header class="view-header">
          <div>
            <h2>Google Flow Studio</h2>
            <span class="view-subtitle">One persistent Chromium profile per account. Sign in once, then reuse the saved session.</span>
          </div>
          <span id="flowSessionBadge" class="status-badge">Checking session</span>
        </header>

        <div class="dashboard-grid">
          <div class="card full-width">
            <div class="card-title">Current Account</div>
            <p class="flow-account-copy"><strong id="flowAccountName">-</strong><br><span id="flowAccountId" class="mono">-</span></p>
            <div class="flow-actions">
              <button id="flowLoginBtn" class="control-btn-small primary"><i class="ph ph-browser"></i> Open Flow in Chromium</button>
              <button id="flowCloseBtn" class="control-btn-small"><i class="ph ph-x"></i> Close Browser</button>
              <button id="flowRefreshBtn" class="control-btn-small"><i class="ph ph-arrows-clockwise"></i> Refresh Status</button>
              <span class="status-badge success"><i class="ph ph-device-mobile"></i> TikTok format locked: 9:16 vertical</span>
            </div>
            <p id="flowSessionMessage" class="flow-session-message">The first login is manual. Session data remains in the account's local Chromium profile.</p>
          </div>

          <div class="card full-width">
            <div class="card-title">Generation Prompt</div>
            <p class="flow-session-message">Build one final Flow prompt from a fixed template and a new Gemini phrase for every video.</p>
            <div class="flow-prompt-sections">
              <div class="form-group flow-prompt-section">
                <label>1. Fixed prompt template</label>
                <p class="flow-field-help">This part remains unchanged. Place <code>{{dynamic}}</code> exactly where the generated phrase must appear.</p>
                <textarea id="flowFixedPromptTemplate" class="control-input flow-prompt-input" rows="6" placeholder="Describe the recurring video style, camera, lighting and sound. Use this text: {{dynamic}}"></textarea>
              </div>
              <div class="form-group flow-prompt-section">
                <label>2. Dynamic content instructions</label>
                <p class="flow-field-help">Tell Gemini the theme, audience and type of phrase you want. It creates a different original phrase for each video.</p>
                <textarea id="flowDynamicInstructions" class="control-input flow-prompt-input" rows="5" placeholder="Example: Write short, intense dark-romance phrases for women who enjoy biker romance. Make every phrase original and suitable for TikTok."></textarea>
              </div>
            </div>
            <div class="form-group flow-api-key-group">
              <label>Gemini API key</label>
              <div class="flow-secret-row">
                <input id="flowGeminiApiKey" class="control-input" type="password" autocomplete="new-password" placeholder="Paste a Google AI Studio API key">
                <span id="flowGeminiKeyStatus" class="status-badge">Not configured</span>
                <button id="flowGeminiKeyRemoveBtn" type="button" class="control-btn-small danger">Remove key</button>
              </div>
              <p class="flow-field-help">The key is stored only in this account's local configuration and is never returned to the browser after saving.</p>
            </div>
            <div class="flow-actions">
              <button id="flowPromptPreviewBtn" type="button" class="control-btn-small"><i class="ph ph-sparkle"></i> Generate preview</button>
            </div>
            <div id="flowPromptPreview" class="flow-prompt-preview hidden" aria-live="polite">
              <strong>Generated phrase</strong>
              <p id="flowPreviewPhrase"></p>
              <strong>Final prompt sent to Flow</strong>
              <pre id="flowPreviewFinalPrompt"></pre>
            </div>
            <div class="flow-reference-row">
              <label class="control-btn-small" for="flowReferenceInput"><i class="ph ph-image"></i> Optional reference image</label>
              <input id="flowReferenceInput" type="file" accept="image/png,image/jpeg,image/webp" hidden>
              <span id="flowReferenceName" class="flow-reference-name">No image selected</span>
              <button id="flowReferenceRemoveBtn" type="button" class="control-btn-small danger">Remove image</button>
              <button id="flowConfigSaveBtn" type="button" class="control-btn-small primary"><i class="ph ph-floppy-disk"></i> Save prompt settings</button>
            </div>
            <p id="flowConfigMessage" class="flow-session-message"></p>
          </div>

          <div class="card full-width">
            <div class="card-title">Daily Generation and TikTok Publishing</div>
            <div class="flow-plan-grid">
              <label>Enabled<input id="flowEnabled" type="checkbox"></label>
              <label>Videos per day<input id="flowVideosPerDay" class="control-input" type="number" min="1" max="3" value="3"></label>
              <label>Generate at<input id="flowDailyTime" class="control-input" type="time" value="06:00"></label>
              <label>Timezone<input id="flowTimezone" class="control-input" value="Europe/Madrid"></label>
              <label>Publish times<input id="flowPublicationTimes" class="control-input" value="09:30, 14:30, 22:10"></label>
              <label>Auto-publish<input id="flowAutoPublish" type="checkbox" checked></label>
            </div>
            <div class="form-group" style="margin-top:14px"><label>TikTok caption</label><input id="flowCaption" class="control-input" placeholder="Optional caption for generated videos"></div>
            <div class="flow-actions" style="margin-top:14px">
              <button id="flowRunNowBtn" class="control-btn-small primary"><i class="ph ph-play"></i> Generate now</button>
            </div>
            <p class="flow-session-message">Daily jobs, permanent downloads and publication dates are persisted. Login, quota or moderation challenges stop visibly instead of being bypassed.</p>
          </div>
          <div class="card full-width">
            <div class="card-header">
              <div>
                <div class="card-title">Saved Flow Videos</div>
                <p class="flow-field-help">Every generated video remains on this PC, including after it is copied to the TikTok queue.</p>
              </div>
              <button id="flowOpenDownloadsBtn" type="button" class="control-btn-small"><i class="ph ph-folder-open"></i> Open folder</button>
            </div>
            <div id="flowDownloadsPath" class="setup-path">Loading permanent download folder...</div>
            <div id="flowDownloadsList" class="flow-downloads-list"><div class="setup-empty">No saved Flow videos yet.</div></div>
          </div>
          <div class="card full-width">
            <div class="card-header"><div class="card-title">Flow Pipeline</div><span id="flowPipelineBadge" class="status-badge">Idle</span></div>
            <div id="flowJobsList" class="autonomous-jobs"></div>
          </div>
        </div>
      </section>

      <section id="view-x-autopilot" class="view-section">
        <header class="view-header">
          <div>
            <h2>X Autopilot</h2>
            <span class="view-subtitle">Generacion diaria, curacion de referencias y cola programada por cuenta.</span>
          </div>
          <span id="xWorkerBadge" class="status-badge">Worker detenido</span>
        </header>
        
        <!-- MARKER: XAP-UI-v1 -->
        <div id="xLoginBanner" class="tt-login-banner card" style="margin-bottom:14px;">
          <div class="tt-login-row">
            <span class="tt-login-icon"><i class="ph ph-x-logo"></i></span>
            <div class="tt-login-text">
              <strong id="xLoginTitle">Sesion de X (Twitter)</strong>
              <span id="xLoginMessage">Inicia sesion en la ventana de X o pega tus cookies para publicar automaticamente.</span>
            </div>
            <span id="xLoginStateBadge" class="status-badge">Sin comprobar</span>
            <button id="xLoginBtn" class="control-btn-small primary"><i class="ph ph-browser"></i> Iniciar sesion</button>
            <button id="xLoginSaveBtn" class="control-btn-small success"><i class="ph ph-floppy-disk"></i> Guardar sesion</button>
            <button id="xLoginCloseBtn" class="control-btn-small danger"><i class="ph ph-x"></i> Cerrar</button>
            <button id="xRetryBtn" class="control-btn-small" title="Reprogramar los posts que fallaron"><i class="ph ph-arrows-clockwise"></i> Reintentar fallidos</button>
          </div>
          <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; align-items:flex-start;">
            <textarea id="xCookiesInput" rows="2" placeholder="O pega aqui tus cookies de X (formato header: auth_token=...; ct0=...  o JSON exportado)" style="flex:1; min-width:260px; font-family:monospace; font-size:11px; padding:8px; border-radius:8px; border:1px solid var(--border-color, #2a2a2a); background:var(--bg-input, #111); color:inherit; resize:vertical;"></textarea>
            <button id="xCookiesBtn" class="control-btn-small"><i class="ph ph-key"></i> Importar cookies</button>
          </div>
        </div>

<div class="x-grid">
          <div class="card">
            <div class="card-title">Perfil y automatizacion</div>
            <div class="settings-grid">
              <div class="form-group"><label>Usuario X</label><input id="xUsername" class="control-input" placeholder="mi_cuenta"></div>
              <div class="form-group"><label>Posts diarios</label><input id="xPostsPerDay" class="control-input" type="number" min="1" max="20" value="3"></div>
              <div class="form-group"><label>Horarios</label><input id="xDailyTimes" class="control-input" placeholder="09:00, 14:00, 19:00"></div>
              <div class="form-group"><label>Modo de publicacion</label><select id="xPostingMode" class="control-input"><option value="simulation">Simulacion local</option><option value="live">API oficial de X</option></select></div>
              <div class="form-group"><label>Tipo de cuenta</label><select id="xAccountTier" class="control-input"><option value="free">Free: 280 caracteres</option><option value="premium">Premium: 4000 caracteres</option></select></div>
              <div class="form-group"><label>Fuente de contenido</label><select id="xContentMode" class="control-input"><option value="ai">Generar con IA</option><option value="recent-search">Buscar posts recientes y reinterpretar</option></select></div>
              <div class="form-group"><label>Tema de busqueda en X</label><input id="xSearchTopic" class="control-input" placeholder="automatizacion con IA"></div>
            </div>
            <!-- MARKER: XAP-LANG-UI-v1 -->
            <div class="form-group" style="margin-top:16px"><label>Idioma de los posts</label><select id="xLanguage" class="control-input" style="max-width:220px;"><option value="en">Ingles</option><option value="es">Espanol</option></select></div>
            <div class="form-group" style="margin-top:16px"><label>Prompt maestro</label><textarea id="xMasterPrompt" class="control-input" rows="5"></textarea></div>
            <!-- MARKER: XAP-AI-CLEAN-v1 -->
            <div class="card" style="margin-top:16px; background:#101317; border:1px solid #242a33;">
              <div class="card-title" style="display:flex; align-items:center; gap:8px; font-size:13px;">
                <i class="ph ph-brain"></i> Modelo de IA
                <span class="tag-ok">automatico</span>
              </div>
              <p class="form-hint" style="margin-bottom:10px;">La IA se elige sola, gratis primero. Se configura una vez en <b>Configuracion IA</b>.</p>
              <div id="xAiChainPreview" class="ai-chain-list"></div>
              <button id="xAiConfigLink" class="control-btn-small" style="margin-top:10px;"><i class="ph ph-gear"></i> Abrir Configuracion IA</button>
            </div>

            <details id="xAdvancedTokens" style="margin-top:14px;">
              <summary style="cursor:pointer; color:var(--text-muted, #8b95a5); font-size:12.5px;">Opciones avanzadas: publicar con la API oficial de X (no necesario)</summary>
              <p class="form-hint" style="margin-top:8px;">Solo si vas a usar la API oficial en vez de tu sesion de X. En el uso normal, dejalo vacio.</p>
              <div class="settings-grid">
                <div class="form-group"><label>Token de acceso X</label><input id="xAccessToken" class="control-input" type="password" placeholder="Solo para la API oficial"></div>
                <div class="form-group"><label>Bearer token X</label><input id="xBearerToken" class="control-input" type="password" placeholder="Para busqueda reciente"></div>
              </div>
            </details>
            <label class="toggle-line" style="margin-top:18px"><input id="xEnabled" type="checkbox"><span>Activar generacion diaria autonoma</span></label>
            <div style="display:flex;gap:10px;margin-top:18px;flex-wrap:wrap"><button id="xSaveBtn" class="control-btn-small primary"><i class="ph ph-floppy-disk"></i> Guardar</button><button id="xGenerateBtn" class="control-btn-small"><i class="ph ph-sparkle"></i> Generar ahora</button><button id="xClearQueueBtn" class="control-btn-small danger"><i class="ph ph-trash"></i> Borrar pendientes</button></div>
            <p id="xLiveStatus" class="form-hint">Las claves no se muestran despues de guardarlas. El modo simulacion no publica en X.</p>
          </div>
          <div class="card">
            <div class="card-title">Curacion de cuenta objetivo</div>
            <p class="form-hint">Anade tweets de referencia para analizar temas y tono. El modelo recibe contexto, pero genera texto nuevo.</p>
            <div class="form-group"><label>Usuario</label><input id="xReferenceUser" class="control-input" placeholder="cuenta_referencia"></div>
            <div class="form-group" style="margin-top:10px"><label>Texto del tweet</label><textarea id="xReferenceText" class="control-input" rows="4"></textarea></div>
            <div class="form-group" style="margin-top:10px"><label>URL opcional</label><input id="xReferenceUrl" class="control-input" placeholder="https://x.com/.../"></div>
            <button id="xReferenceBtn" class="control-btn-small primary" style="margin-top:12px"><i class="ph ph-plus"></i> Anadir referencia</button>
            <div id="xReferencesList" class="x-reference-list"></div>
          </div>
          <div class="card full-width">
            <div class="card-header"><div class="card-title">Cola X</div><span id="xQueueCount" class="status-badge">0</span></div>
            <div id="xQueueList" class="x-queue-list"></div>
            <div id="xLogs" class="logs-container" style="margin-top:16px;height:140px"></div>
          </div>
        </div>
      </section>
    </main>
  </div>
  <script src="app.js"></script>
  <script src="studio-assets/studio.js"></script>
  <script src="autoclone.js"></script>
  <script src="autopost.js"></script>
    <script src="acct-session.js" defer></script>
    <script src="acct-radar-ui.js" defer></script>
<!-- MARKER: LANG-EN-FIRST-v1 -->
</body>

</html>
