// X (Twitter) session + posting helper for AutoSocial Studio.
// Reuses the persistent Playwright profile pattern (.profiles/<accountId>/x)
// and the Netscape cookie jar (.runtime/cookies/<accountId>.txt).
//
// AUTO-GENERATED by instalar-x-autopilot-fix.js -- do not edit by hand unless you
// also bump the patch markers in that installer.

// MARKER: XAP-AUTH-v1
const fs = require("fs/promises");
const path = require("path");
const { config } = require("./config");
const { getActiveAccount, getPlatformProfileDir, hasSavedPlatformSession } =
  require("./account-manager");
const { saveCookiesFromContext, cookieFilePath } = require("./cookie-jar");

const PLATFORM = "x";
const HOME_URL = "https://x.com/home";
const COMPOSE_URL = "https://x.com/compose/post";
const LOGIN_URL = "https://x.com/i/flow/login";

let loginContext = null;
let loginAccountId = null;
const debugContexts = new Map();

function chromeCandidates() {
  if (process.platform === "win32") {
    return [
      path.join(process.env.PROGRAMFILES || "", "Google", "Chrome", "Application", "chrome.exe"),
      path.join(process.env["PROGRAMFILES(X86)"] || "", "Google", "Chrome", "Application", "chrome.exe"),
    ];
  }
  return ["/usr/bin/google-chrome", "/usr/bin/google-chrome-stable", "/usr/bin/chromium"];
}

async function firstExisting(candidates) {
  for (const candidate of candidates) {
    if (!candidate) continue;
    try {
      await fs.access(candidate);
      return candidate;
    } catch {}
  }
  return null;
}

async function launch(options, profileDir) {
  let chromium;
  try {
    ({ chromium } = require("playwright"));
  } catch (error) {
    throw new Error("Playwright no esta instalado. Ejecuta: npm install playwright");
  }

  await clearStaleProfileLock(profileDir);

  const chrome = await firstExisting(chromeCandidates());
  // En Windows, usar el Chrome ya instalado es mas fiable que el Chromium de
  // Playwright (que puede no estar descargado: "Executable doesn't exist").
  if (chrome) {
    try {
      return await chromium.launchPersistentContext(profileDir, { ...options, executablePath: chrome });
    } catch (error) {
      if (!/Executable doesn't exist|does not exist/i.test(error.message || "")) throw error;
    }
  }

  try {
    return await chromium.launchPersistentContext(profileDir, options);
  } catch (error) {
    const msg = String(error.message || error);
    if (/Executable doesn't exist|does not exist/i.test(msg)) {
      throw new Error("No se encontro el navegador. Instala Chrome o ejecuta: npx playwright install chromium");
    }
    throw error;
  }
}

// Un Chromium cerrado a la fuerza deja SingletonLock / SingletonCookie en el
// perfil y el siguiente lanzamiento cuelga con "profile in use". Los quitamos.
async function clearStaleProfileLock(profileDir) {
  const names = ["SingletonLock", "SingletonCookie", "SingletonSocket", "lockfile"];
  for (const name of names) {
    try { await fs.rm(path.join(profileDir, name), { force: true }); } catch {}
  }
}

async function openPersistentContext(accountId) {
  const profileDir = await getPlatformProfileDir(PLATFORM, accountId);
  await fs.mkdir(profileDir, { recursive: true });
  const options = {
    headless: false,
    acceptDownloads: true,
    viewport: { width: 1440, height: 960 },
    locale: config.browserLocale || "es-ES",
    timezoneId: config.timezone || "Europe/Madrid",
    args: ["--disable-blink-features=AutomationControlled"],
  };
  try {
    return await launch(options, profileDir);
  } catch (error) {
    const msg = String(error.message || error);
    if (/ProcessSingleton|SingletonLock|already running|profile.*in use|EADDRINUSE/i.test(msg)) {
      throw new Error(
        "Ya hay una ventana de X abierta con este perfil. Cierrala (o pulsa «Cerrar» en la pestana) y vuelve a intentarlo."
      );
    }
    throw error;
  }
}

async function isLoggedIn(context) {
  const cookies = await context.cookies("https://x.com").catch(() => []);
  const names = new Set(cookies.map((c) => c.name));
  return names.has("auth_token") && names.has("ct0");
}

async function readStoredCookies(accountId) {
  const file = cookieFilePath(accountId);
  let raw;
  try {
    raw = await fs.readFile(file, "utf8");
  } catch {
    return [];
  }
  const cookies = [];
  for (const line of raw.split(/\r?\n/)) {
    if (!line || line.startsWith("#")) continue;
    const parts = line.split("\t");
    if (parts.length < 7) continue;
    const [domain, , cookiePath, secure, expires, name, value] = parts;
    if (!name || !value) continue;
    if (!/x\.com|twitter\.com/.test(domain)) continue;
    cookies.push({
      name,
      value,
      domain,
      path: cookiePath || "/",
      secure: String(secure).toUpperCase() === "TRUE",
      httpOnly: false,
      expires: Number(expires) > 0 ? Number(expires) : -1,
      sameSite: "Lax",
    });
  }
  return cookies;
}

async function closeLoginSession() {
  const account = await getActiveAccount();
  const context = debugContexts.get(account.id);
  if (context) {
    debugContexts.delete(account.id);
    await context.close().catch(() => {});
  }
  if (!loginContext) return { ok: true, alreadyClosed: true };
  const current = loginContext;
  loginContext = null;
  loginAccountId = null;
  await current.close().catch(() => {});
  return { ok: true, alreadyClosed: false };
}

/**
 * Open a throwaway context with the saved X session already loaded.
 * Used by the account analyzer: it reads profiles with the real session but
 * must NOT persist anything back into the profile (that is the caller's job).
 */
async function openScratchContext() {
  const account = await getActiveAccount();
  // Si ya hay una ventana de login abierta para esta cuenta, reutilizamos su
  // contexto: asi el analisis no choca con el candado del perfil.
  if (loginContext && loginAccountId === account.id) {
    const page = loginContext.pages()[0] || (await loginContext.newPage());
    return {
      context: loginContext,
      page,
      account,
      close: async () => {},
      reused: true,
    };
  }
  const context = await openPersistentContext(account.id);
  try {
    if (!(await isLoggedIn(context))) {
      const stored = await readStoredCookies(account.id);
      if (stored.length) await context.addCookies(stored);
    }
    if (!(await isLoggedIn(context))) {
      throw new Error("La sesion de X no esta activa. Inicia sesion en X y pulsa Guardar sesion.");
    }
    const page = context.pages()[0] || (await context.newPage());
    return {
      context,
      page,
      account,
      close: async () => { await context.close().catch(() => {}); },
      reused: false,
    };
  } catch (error) {
    await context.close().catch(() => {});
    throw error;
  }
}

async function startLoginSession() {
  const account = await getActiveAccount();
  await closeLoginSession();
  console.log("[x-auth] abriendo ventana de login para la cuenta", account.id);
  try {
    loginContext = await openPersistentContext(account.id);
  } catch (error) {
    console.error("[x-auth] no se pudo abrir la ventana:", error.message);
    throw error;
  }
  loginAccountId = account.id;
  const context = loginContext;
  context.on("close", () => {
    if (loginContext === context) {
      loginContext = null;
      loginAccountId = null;
    }
  });
  const page = context.pages()[0] || (await context.newPage());
  console.log("[x-auth] ventana abierta, cargando", LOGIN_URL);
  // Navega en segundo plano: si X tarda o pide captcha, la peticion HTTP ya
  // ha respondido y la ventana sigue abierta para que el usuario entre.
  page.goto(LOGIN_URL, { waitUntil: "domcontentloaded", timeout: 120000 }).catch((error) => {
    console.error("[x-auth] la pagina de login no cargo:", error.message);
  });
  return {
    ok: true,
    url: LOGIN_URL,
    accountId: account.id,
    message: "Ventana de X abierta. Inicia sesión y pulsa «Guardar sesión».",
  };
}

async function saveLoginSession() {
  const account = await getActiveAccount();
  if (!loginContext || loginAccountId !== account.id) {
    return { ok: false, error: "No hay ninguna ventana de login abierta para esta cuenta." };
  }
  const cookies = await loginContext.cookies("https://x.com").catch(() => []);
  const names = new Set(cookies.map((c) => c.name));
  if (!names.has("auth_token") || !names.has("ct0")) {
    return { ok: false, error: "Aún no has iniciado sesión en X (faltan cookies auth_token/ct0)." };
  }
  await saveCookiesFromContext(loginContext, account.id);
  const handle = await currentHandle(loginContext);
  return { ok: true, handle, accountId: account.id, cookies: cookies.length };
}

async function currentHandle(context) {
  const page = context.pages()[0];
  if (!page) return null;
  try {
    const url = page.url();
    const match = url.match(/(?:x|twitter)\.com\/([A-Za-z0-9_]{1,15})(?:\/|$)/);
    if (match && !["home", "compose", "i", "explore", "notifications", "messages"].includes(match[1])) {
      return "@" + match[1];
    }
  } catch {}
  return null;
}

async function importCookies(rawText) {
  const account = await getActiveAccount();
  const text = String(rawText || "").trim();
  if (!text) return { ok: false, error: "Pega las cookies de X primero." };

  let cookies = [];
  if (text.startsWith("[") || text.startsWith("{")) {
    let parsed;
    try {
      parsed = JSON.parse(text);
    } catch (error) {
      return { ok: false, error: `JSON inválido: ${error.message}` };
    }
    const list = Array.isArray(parsed) ? parsed : parsed.cookies;
    if (!Array.isArray(list)) return { ok: false, error: "El JSON no contiene una lista de cookies." };
    cookies = list
      .filter((c) => c && c.name && c.value !== undefined)
      .map((c) => ({
        name: String(c.name),
        value: String(c.value),
        domain: c.domain || ".x.com",
        path: c.path || "/",
        secure: c.secure !== false,
        httpOnly: Boolean(c.httpOnly),
        expires: Number(c.expirationDate || c.expires || -1) || -1,
        sameSite: c.sameSite === "no_restriction" ? "None" : c.sameSite || "Lax",
      }));
  } else {
    const headerFormat = /(?:^|;\s*)(auth_token|ct0)=([^;]+)/g;
    let match;
    let found = false;
    while ((match = headerFormat.exec(text)) !== null) {
      found = true;
      cookies.push({
        name: match[1],
        value: match[2].trim(),
        domain: ".x.com",
        path: "/",
        secure: true,
        httpOnly: false,
        expires: -1,
        sameSite: "Lax",
      });
    }
    if (!found) {
      // Netscape jar passthrough
      const jarFile = cookieFilePath(account.id);
      const tmp = [];
      for (const line of text.split(/\r?\n/)) {
        const parts = line.split("\t");
        if (parts.length < 7) continue;
        const [domain, , cookiePath, secure, expires, name, value] = parts;
        if (!/x\.com|twitter\.com/.test(domain)) continue;
        tmp.push({
          name,
          value,
          domain,
          path: cookiePath || "/",
          secure: String(secure).toUpperCase() === "TRUE",
          httpOnly: false,
          expires: Number(expires) || -1,
          sameSite: "Lax",
        });
      }
      cookies = tmp;
    }
  }

  const names = new Set(cookies.map((c) => c.name));
  if (!names.has("auth_token") || !names.has("ct0")) {
    return { ok: false, error: "Faltan las cookies auth_token o ct0. Copia al menos esas dos." };
  }

  // Convert to Netscape format and store 0600.
  await fs.mkdir(path.dirname(cookieFilePath(account.id)), { recursive: true });
  const lines = ["# Netscape HTTP Cookie File", "# Imported by AutoSocial Studio X Autopilot"];
  for (const c of cookies) {
    lines.push(
      [
        c.domain,
        c.domain.startsWith(".") ? "TRUE" : "FALSE",
        c.path,
        c.secure ? "TRUE" : "FALSE",
        c.expires || 0,
        c.name,
        c.value,
      ].join("\t")
    );
  }
  await fs.writeFile(cookieFilePath(account.id), lines.join("\n") + "\n", { mode: 0o600 });

  // Best-effort validation: opens a browser to confirm the cookies still work.
  // A validation failure (offline, no Chromium) does not discard the saved file.
  const validation = await validateCookies(cookies).catch((error) => ({ ok: false, error: error.message }));
  return {
    ok: true,
    validated: Boolean(validation.ok),
    warning: validation.ok ? undefined : `Cookies guardadas, pero no se pudieron verificar: ${validation.error || "sesion no confirmada"}`,
    accountId: account.id,
    handle: validation.handle,
    cookies: cookies.length,
  };
}

async function validateCookies(cookies) {
  const account = await getActiveAccount();
  const context = await openPersistentContext(account.id);
  try {
    await context.addCookies(cookies);
    const page = context.pages()[0] || (await context.newPage());
    await page.goto(HOME_URL, { waitUntil: "domcontentloaded", timeout: 60000 });
    const valid = await isLoggedIn(context);
    return { ok: valid, handle: await currentHandle(context), error: valid ? undefined : "Las cookies no iniciaron sesión en X." };
  } finally {
    await context.close().catch(() => {});
  }
}

async function getSessionStatus() {
  const account = await getActiveAccount();
  let profileSaved = false;
  try { profileSaved = await hasSavedPlatformSession(PLATFORM, account.id); } catch {}
  const stored = await readStoredCookies(account.id);
  const jarSaved = stored.some((c) => c.name === "auth_token") && stored.some((c) => c.name === "ct0");
  return {
    accountId: account.id,
    open: Boolean(loginContext && loginAccountId === account.id) || debugContexts.has(account.id),
    saved: profileSaved || jarSaved,
    source: profileSaved ? "browser" : (jarSaved ? "cookies" : "none"),
  };
}

async function withSession(fn) {
  const account = await getActiveAccount();

  // Si hay cookies guardadas, publicamos con un contexto ligero (sin perfil
  // persistente). Asi nunca chocamos con la ventana de login/analisis que pueda
  // estar abierta con el mismo --user-data-dir.
  const stored = await readStoredCookies(account.id);
  const hasCookieSession =
    stored.some((c) => c.name === "auth_token") && stored.some((c) => c.name === "ct0");
  if (hasCookieSession) {
    const context = await openCookieContext(account.id, stored);
    try {
      if (!(await isLoggedIn(context))) {
        throw new Error("Las cookies guardadas de X no son validas (caducaron). Inicia sesion de nuevo.");
      }
      return await fn(context, account);
    } finally {
      await context.close().catch(() => {});
    }
  }

  const context = await openPersistentContext(account.id);
  try {
    if (!(await isLoggedIn(context))) {
      if (stored.length) await context.addCookies(stored);
    }
    if (!(await isLoggedIn(context))) {
      throw new Error("No hay sesión de X guardada. Inicia sesión o importa tus cookies primero.");
    }
    return await fn(context, account);
  } catch (error) {
    const msg = String(error.message || error);
    if (/ProcessSingleton|SingletonLock|already running|profile.*in use|has been closed|existing browser session/i.test(msg)) {
      throw new Error(
        "Hay una ventana de Chrome abierta con el perfil de X y bloquea la publicacion. Cierrala (o pulsa «Cerrar» en la pestana de sesion) y vuelve a intentarlo."
      );
    }
    throw error;
  } finally {
    await saveCookiesFromContext(context, account.id).catch(() => {});
    await context.close().catch(() => {});
  }
}

// Contexto efimero con cookies inyectadas: no toca el perfil persistente, asi
// que puede publicar aunque la ventana de login este abierta. Sin --user-data-dir,
// asi que jamas puede chocar con el perfil de X.
// Usa el Chromium de Playwright (navegador propio, aislado) y solo cae al Chrome
// del sistema si Chromium no esta descargado.
// MARKER: XAP-AUTH-CHROMIUM-v1
async function openCookieContext(accountId, cookies) {
  const { chromium } = require("playwright");
  const options = {
    headless: true,
    locale: config.browserLocale || "es-ES",
    timezoneId: config.timezone || "Europe/Madrid",
    args: ["--disable-blink-features=AutomationControlled"],
  };
  let browser;
  try {
    // Chromium de Playwright: su propio binario, sin relacion con tu Chrome.
    browser = await chromium.launch(options);
  } catch (error) {
    if (!/Executable doesn't exist|does not exist|ENOENT/i.test(error.message || "")) throw error;
    const chrome = await firstExisting(chromeCandidates());
    if (!chrome) {
      throw new Error("No hay navegador para publicar. Ejecuta: npx playwright install chromium");
    }
    browser = await chromium.launch({ ...options, executablePath: chrome });
  }
  const context = await browser.newContext({
    viewport: { width: 1440, height: 960 },
    locale: options.locale,
    timezoneId: options.timezoneId,
  });
  // Cierra el navegador cuando se cierre el contexto.
  const originalClose = context.close.bind(context);
  context.close = async () => {
    await originalClose().catch(() => {});
    await browser.close().catch(() => {});
  };
  await context.addCookies(cookies);
  return context;
}

async function postTweet(text) {
  const account = await getActiveAccount();
  const body = String(text || "").trim();
  if (!body) throw new Error("El texto del post está vacío.");
  const max = 280;
  if (body.length > max) throw new Error(`El post supera ${max} caracteres (${body.length}).`);

  return withSession(async (context) => {
    const page = context.pages()[0] || (await context.newPage());
    await page.goto(COMPOSE_URL, { waitUntil: "domcontentloaded", timeout: 90000 });
    await page.waitForTimeout(2500);

    const editor = await firstVisibleLocator(page, [
      '[data-testid="tweetTextarea_0"]',
      'div[role="textbox"][contenteditable="true"]',
      'div[contenteditable="true"]',
    ]);
    if (!editor) throw new Error("No se encontró el cuadro de redacción de X (¿sesión caducada?).");
    await editor.click();
    await editor.type(body, { delay: 18 });
    await page.waitForTimeout(600);

    const button = await firstVisibleLocator(page, [
      '[data-testid="tweetButton"]',
      '[data-testid="tweetButtonInline"]',
    ]);
    if (!button) throw new Error("No se encontró el botón de publicar de X.");
    // A partir de aquí X ya tiene el texto: si falla algo (la pagina se cierra,
    // X va lento, no llega el aviso) NO lo tratamos como fallo. Damos el post
    // por publicado para no reintentar nunca y evitar publicaciones en cadena.
    try {
      await button.click();
    } catch (error) {
      throw new Error(`No se pudo pulsar Publicar: ${error.message}`);
    }
    await confirmPublished(page);
    return { ok: true, accountId: account.id, length: body.length };
  });
}

/**
 * Confirma que el post salio de verdad.
 * MARKER: XAP-CONFIRM-v2
 *
 * IMPORTANTE: esto es SOLO informativo. Pase lo que pase, termina sin lanzar
 * error. Si el boton de Publicar se pulso, el post se da por publicado. Antes
 * se lanzaba error cuando X tardaba en cerrar el compositor y eso provocaba
 * publicaciones en cadena (cada reintento publicaba otra vez).
 */
async function confirmPublished(page) {
  const deadline = Date.now() + 12000;
  try {
    while (Date.now() < deadline) {
      const state = await page.evaluate(() => {
        const toast = document.querySelector('[data-testid="toast"]');
        const toastText = toast ? (toast.innerText || "") : "";
        const sent = /sent|enviad|publicad|posted/i.test(toastText);
        const editors = Array.from(document.querySelectorAll('[data-testid="tweetTextarea_0"]'));
        const visibleEditors = editors.filter((e) => {
          const r = e.getBoundingClientRect();
          return r.width > 0 && r.height > 0;
        });
        let hasText = false;
        for (const e of visibleEditors) {
          if ((e.innerText || "").trim().length > 0) { hasText = true; break; }
        }
        const btn = document.querySelector('[data-testid="tweetButton"]') || document.querySelector('[data-testid="tweetButtonInline"]');
        const disabled = btn ? (btn.getAttribute("aria-disabled") === "true" || btn.disabled === true) : false;
        return { sent, editors: visibleEditors.length, hasText, disabled };
      });
      if (state.sent) return true;
      if (state.editors === 0) return true;
      if (state.editors > 0 && !state.hasText) return true;
      if (state.disabled) return true;
      await page.waitForTimeout(1000);
    }
  } catch (error) {
    // La pagina se cerro o CDP fallo: no es motivo para reintentar.
    return true;
  }
  return true;
}


/**
 * Publica un texto con imagenes del post original.
 * MARKER: XAP-POST-RICH-v1
 * Si falla la descarga o el adjuntado de una imagen, publica solo el texto.
 */
async function postTweetRich(text, images) {
  const account = await getActiveAccount();
  const body = String(text || "").trim();
  if (!body) throw new Error("El texto del post esta vacio.");
  const list = Array.isArray(images) ? images.filter(Boolean).slice(0, 4) : [];

  return withSession(async (context) => {
    const page = context.pages()[0] || (await context.newPage());
    await page.goto(COMPOSE_URL, { waitUntil: "domcontentloaded", timeout: 90000 });
    await page.waitForTimeout(2500);

    const editor = await firstVisibleLocator(page, [
      '[data-testid="tweetTextarea_0"]',
      'div[role="textbox"][contenteditable="true"]',
      'div[contenteditable="true"]',
    ]);
    if (!editor) throw new Error("No se encontro el cuadro de redaccion de X (sesion caducada?).");

    if (list.length) {
      try {
        const paths = [];
        const os = require("os");
        const fsp = require("fs/promises");
        const pathMod = require("path");
        for (let i = 0; i < list.length; i++) {
          const res = await context.request.get(list[i], { timeout: 20000 });
          if (!res.ok()) continue;
          const buf = await res.body();
          const ct = res.headers()["content-type"] || "image/jpeg";
          const ext = ct.includes("png") ? "png" : ct.includes("webp") ? "webp" : "jpg";
          const file = pathMod.join(os.tmpdir(), "radar-" + Date.now() + "-" + i + "." + ext);
          await fsp.writeFile(file, buf);
          paths.push(file);
        }
        if (paths.length) {
          const input = page.locator('input[type="file"]').first();
          await input.setInputFiles(paths);
          await page.waitForTimeout(5000);
        }
      } catch (e) {
        console.error("[x-auth] no se pudieron adjuntar imagenes:", e.message);
      }
    }

    await editor.click();
    await editor.type(body, { delay: 18 });
    await page.waitForTimeout(600);

    const button = await firstVisibleLocator(page, [
      '[data-testid="tweetButton"]',
      '[data-testid="tweetButtonInline"]',
    ]);
    if (!button) throw new Error("No se encontro el boton de publicar de X.");
    try {
      await button.click();
    } catch (error) {
      throw new Error("No se pudo pulsar Publicar: " + error.message);
    }
    await confirmPublished(page);

    return { ok: true, accountId: account.id, length: body.length, images: list.length };
  });
}

async function firstVisibleLocator(page, selectors) {
  for (const selector of selectors) {
    const locator = page.locator(selector).first();
    try {
      if (await locator.isVisible({ timeout: 1500 })) return locator;
    } catch {}
  }
  return null;
}

module.exports = {
  PLATFORM,
  startLoginSession,
  saveLoginSession,
  closeLoginSession,
  importCookies,
  getSessionStatus,
  postTweet,
  postTweetRich,
  openScratchContext,
};
