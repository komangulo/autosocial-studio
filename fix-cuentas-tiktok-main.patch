+  // AISLAR-CUENTAS-TIKTOK: resuelve la cuenta a usar. Si el frontend manda
+  // accountId, se valida y se usa ESA cuenta (la del perfil seleccionado); si
+  // no llega o no es valida, se cae a la cuenta activa (comportamiento previo).
+  // Sin esto, programar desde un perfil que NO es el activo se va a la cuenta
+  // activa global (p. ej. KapiBlue acababa programando en Madrid Nueva Modelo).
+  const resolveTikTokAccount = async (req) => {
+    const requested = req?.body?.accountId || req?.query?.accountId;
+    const validator = context.getAccount || context.requireAccount;
+    if (requested && typeof validator === "function") {
+      try {
+        const account = await validator(requested);
+        if (account?.id) return account;
+      } catch {
+        // accountId invalido: se cae a la cuenta activa.
+      }
+    }
+    return await context.getActiveAccount();
+  };
